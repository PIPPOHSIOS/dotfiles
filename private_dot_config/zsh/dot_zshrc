# Remove subtitle lines repetition from youtube automatic subs
convertautosubs() {
    for lang in "en" "ru" "ja"; do
        fn=$(echo "$1" | sed "s/%(ext)s/$lang.srt/g")
        ffmpeg -fix_sub_duration -i "$fn" -c:s text "$fn".tmp.srt
        mv "$fn".tmp.srt "$fn"
    done
}

