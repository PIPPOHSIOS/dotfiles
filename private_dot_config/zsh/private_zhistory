/**\
 * @param {string} term \
 * @returns {string}\
 */\
function normalizeOrthography(term) {\
    switch (source_iso) {\
        case 'ar':\
        case 'fa':\
            const optionalDiacritics = [\
                '\u0618', // Small Fatha\
                '\u0619', // Small Damma\
                '\u061A', // Small Kasra\
                '\u064B', // Fathatan\
                '\u064C', // Dammatan\
                '\u064D', // Kasratan\
                '\u064E', // Fatha\
                '\u064F', // Damma\
                '\u0650', // Kasra\
                '\u0651', // Shadda\
                '\u0652', // Sukun\
                '\u0653', // Maddah\
                '\u0654', // Hamza Above\
                '\u0655', // Hamza Below\
                '\u0656', // Subscript Alef\
                '\u0670', // Dagger Alef\
            ];\
            \
            const diacriticsRegex = new RegExp(`[${optionalDiacritics.join('')}]`, 'g');\
            \
            return term.replace(diacriticsRegex, '')\
        case 'la':\
        case 'ang':\
        case 'sga':\
        case 'grc':\
        case 'ro':\
        case 'it':\
            return term.normalize('NFD').replace(/[\u0300-\u036f]/g, '');\
        case 'tl':\
            return term.normalize('NFD').replace(/[\u0300-\u036f\-']/g, '');\
        case 'sh':\
            return term.normalize('NFD').replace(/[aeiourAEIOUR][\u0300-\u036f]/g, (match) => match[0]);\
        case 'uk':\
        case 'ru':\
            return term.replace(/́/g, '');\
        default:\
            return term;\
    }\
}\
