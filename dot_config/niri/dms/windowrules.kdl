// DMS Window Rules - Managed by Dux Shell
// Do not edit manually - changes may be overwritten

// @id=wr_1793793628551272855 @name=librewolf
window-rule {
    match app-id="^librewolf$"
    open-maximized-to-edges true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=wr_1789236305963808019 @name=Blur Kitty
window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
    }
}

// @id=wr_1789399415796898898 @name=org.kde.dolphin
window-rule {
    match app-id="^org.kde.dolphin$"
    opacity 0.90
    open-floating true
    background-effect {
        blur true
        xray false
    }
}

// @id=wr_1789236478662342341 @name=Fcitx5 Input Window
window-rule {
    match app-id="^fcitx$" title="^Fcitx5 Input WIndow$"
    opacity 1.00
    open-floating true
}

// @id=wr_1789236675652285169 @name=MPV
window-rule {
    match app-id="^mpv$"
    default-column-width { fixed 1024; }
    default-window-height { fixed 567; }
    tiled-state true
}

// @id=wr_1789236716897788992 @name=Anki
window-rule {
    match app-id="^anki$" title="^- Anki$"
    open-maximized-to-edges true
}

// @id=wr_1789236748595872064 @name=Anki - Edit Current
window-rule {
    match app-id="^anki$" title="^Edit Current$"
    open-floating true
}

// @id=wr_1791021359159618164 @name=com.gabm.satty
window-rule {
    match app-id="^com.gabm.satty$"
    open-floating true
    default-column-width { fixed 1280; }
    default-window-height { fixed 720; }
}

// @id=wr_1791022747093282448 @name=org.kde.ark
window-rule {
    match app-id="^org.kde.ark$"
    open-floating true
}

// @id=wr_1791106344053985962 @name=MATLAB R2026b
window-rule {
    match app-id="^MATLAB R2026b$" title="(Figures|Scope|Block Parameters|Configuration Parameters|Create New Data)"
    open-floating true
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
